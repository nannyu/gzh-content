name: "Stash 国内直连 · 黑名单代理（轻量版）"
desc: |-
  适用于 Stash 3.4.1；先关闭旧版覆写，仅启用本版。
  采用国内 DoH；保留原订阅节点和策略组，国内及未命中流量默认直连。
  轻量广告拦截，覆盖范围较原版收窄；闲置策略组跳过自动测速。
  手动节点统一在手动选择组设置；服务组默认跟随主组。
  国内应用、支付及银行优先直连；保留原通用规则。
author: "Codex"
version: "2026.10.07.4"

mode: rule

# 本地 DNS 修正：国内直连流量采用可达的国内解析器。
# 数组完全替换，避免与订阅中超时的海外 DoH 合并。
dns:
  follow-rule: false
  nameserver: #!replace
    - "https://223.5.5.5/dns-query"
    - "https://doh.pub/dns-query"


# 原订阅已验证可用：继承 IPv6、proxies、proxy-providers 和原有代理链；DNS 由本覆写修正。
# 新组前缀防止覆盖订阅同名组；不使用 #!replace 删除原有策略组。
# include-all 引用原订阅的全部节点及远程代理集，不包含任何订阅凭据。
# Stash 3.4.1 实测：include-all 与 proxies 混用会丢失显式组引用，禁止混用。
# 主组/服务组仅引用其他组；自动/手动组才使用 include-all。
# 基础订阅必须有可用节点；Stash 会将完全没有节点的组视作 DIRECT。
# 全部新增组启用 lazy，闲置时跳过自动测速；保留 600 秒周期与订阅原有测速设置。
proxy-groups:
- name: 黑名单 · 代理模式
  type: select
  lazy: true
  proxies:
  - 黑名单 · 自动优选
  - 黑名单 · 手动选择
- name: 黑名单 · 自动优选
  type: url-test
  include-all: true
  interval: 600
  lazy: true
- name: 黑名单 · 手动选择
  type: select
  lazy: true
  include-all: true
- name: 黑名单 · AI开发
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · ChatGPT
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · Claude
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · Google服务
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · Spotify
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · 影音流媒体
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · 电报消息
  type: select
  lazy: true
  proxies:
  - 黑名单 · 代理模式
  - 黑名单 · 手动选择
- name: 黑名单 · 广告拦截
  type: select
  lazy: true
  proxies:
  - REJECT
  - DIRECT
- name: 黑名单 · 漏网之鱼
  type: select
  lazy: true
  proxies:
  - DIRECT
  - 黑名单 · 代理模式

# 独立命名的规则集与原订阅合并，避免删除其其他功能依赖。
rule-providers:
  # AWAvenue 常见广告域名；保留 domain 压缩格式，不再加载大型全量广告库。
  nyb-reject-lite:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/TG-Twilight/AWAvenue-Ads-Rule@main/Filters/AWAvenue-Ads-Rule-Clash.yaml
    interval: 86400
  nyb-private:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/private.txt
    interval: 86400
  nyb-direct:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt
    interval: 86400
  nyb-lancidr:
    behavior: ipcidr
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/lancidr.txt
    interval: 86400
  nyb-gfw:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt
    interval: 86400
  nyb-proxy:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt
    interval: 86400
  nyb-github:
    behavior: classical
    format: yaml
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/GitHub/GitHub.yaml
    interval: 86400
  nyb-telegramcidr:
    behavior: ipcidr
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/telegramcidr.txt
    interval: 86400
  nyb-openai:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/OpenAI/OpenAI.yaml
    interval: 86400
  nyb-claude:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Claude/Claude.yaml
    interval: 86400
  nyb-youtube:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/YouTube/YouTube.yaml
    interval: 86400
  nyb-netflix:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix.yaml
    interval: 86400
  nyb-spotify:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Spotify/Spotify.yaml
    interval: 86400

# 只替换分流规则，明确保持黑名单默认直连语义。
# 顺序：本地网络 → 显式服务/直连例外 → 服务集 → 私网 → 广告 → 国内 → 黑名单 → 默认。
rules: #!replace
- IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
- IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
- IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
- IP-CIDR6,::1/128,DIRECT,no-resolve
- IP-CIDR6,fc00::/7,DIRECT,no-resolve
- IP-CIDR6,fe80::/10,DIRECT,no-resolve
- IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
- IP-CIDR6,fd7a:115c:a1e0::/48,DIRECT,no-resolve
# BEGIN 国内应用优先直连 2026-10-07
