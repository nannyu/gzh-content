name: "Stash 国内直连 · 黑名单代理（修正版）"
desc: |-
  适用于 Stash 3.4.1；先关闭旧版覆写，仅启用本版。
  保留原订阅 DNS、节点和策略组；国内及未命中流量默认直连。
  修复失效规则源，显式服务例外优先于广告；各服务可直接选择节点。
author: "Codex"
version: "2026.09.06.1"

mode: rule

# 原订阅已验证可用：继承 DNS、IPv6、proxies、proxy-providers 和原有代理链。
# 新组前缀防止覆盖订阅同名组；不使用 #!replace 删除原有策略组。
# include-all 引用原订阅的全部节点及远程代理集，不包含任何订阅凭据。
# 移除可能为空的地区过滤组；各服务展开后可直接选美国/日本等具体节点。
# 基础订阅必须有可用节点；Stash 会将完全没有节点的组视作 DIRECT。
proxy-groups:
- name: 黑名单 · 代理模式
  type: select
  proxies:
  - 黑名单 · 自动优选
  include-all: true
- name: 黑名单 · 自动优选
  type: url-test
  include-all: true
  interval: 600
  lazy: true
- name: 黑名单 · AI开发
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · ChatGPT
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · Claude
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · Google服务
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · Spotify
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · 影音流媒体
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · 电报消息
  type: select
  proxies:
  - 黑名单 · 代理模式
  include-all: true
- name: 黑名单 · 广告拦截
  type: select
  proxies:
  - REJECT
  - DIRECT
- name: 黑名单 · 漏网之鱼
  type: select
  proxies:
  - DIRECT
  - 黑名单 · 代理模式

# 独立命名的规则集与原订阅合并，避免删除其其他功能依赖。
rule-providers:
  nyb-reject:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt
    interval: 86400
  nyb-private:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/private.txt
    interval: 86400
  nyb-direct:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt
    interval: 86400
  nyb-lancidr:
    behavior: ipcidr
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/lancidr.txt
    interval: 86400
  nyb-gfw:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt
    interval: 86400
  nyb-proxy:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt
    interval: 86400
  nyb-github:
    behavior: classical
    format: yaml
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/GitHub/GitHub.yaml
    interval: 86400
  nyb-telegramcidr:
    behavior: ipcidr
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/telegramcidr.txt
    interval: 86400
  nyb-openai:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/OpenAI/OpenAI.yaml
    interval: 86400
  nyb-claude:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Claude/Claude.yaml
    interval: 86400
  nyb-youtube:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/YouTube/YouTube.yaml
    interval: 86400
  nyb-netflix:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix.yaml
    interval: 86400
  nyb-spotify:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Spotify/Spotify.yaml
    interval: 86400

# 只替换分流规则，明确保持黑名单默认直连语义。
# 顺序：本地网络 → 显式服务/直连例外 → 服务集 → 私网 → 广告 → 国内 → 黑名单 → 默认。
rules: #!replace
- IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
- IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
- IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
- IP-CIDR6,::1/128,DIRECT,no-resolve
- IP-CIDR6,fc00::/7,DIRECT,no-resolve
- IP-CIDR6,fe80::/10,DIRECT,no-resolve
- IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
- IP-CIDR6,fd7a:115c:a1e0::/48,DIRECT,no-resolve
- DOMAIN,t.nyxbits.com,黑名单 · 代理模式
- DOMAIN-SUFFIX,google-analytics.com,黑名单 · Google服务
- DOMAIN-SUFFIX,googletagservices.com,黑名单 · Google服务
- DOMAIN-SUFFIX,claude.ai,黑名单 · Claude
- DOMAIN-SUFFIX,claude.com,黑名单 · Claude
- DOMAIN-SUFFIX,anthropic.com,黑名单 · Claude
- DOMAIN-SUFFIX,segment.io,黑名单 · Claude
- DOMAIN-SUFFIX,website-files.com,黑名单 · Claude
- DOMAIN-SUFFIX,intellimize.co,黑名单 · Claude
- DOMAIN-SUFFIX,amplitude.com,黑名单 · Claude
- DOMAIN-SUFFIX,xbookcn.net,黑名单 · 影音流媒体
- DOMAIN-SUFFIX,youtube.com,黑名单 · 影音流媒体
- DOMAIN-SUFFIX,youtu.be,黑名单 · 影音流媒体
- DOMAIN-SUFFIX,ytimg.com,黑名单 · 影音流媒体
