name: "Stash 国内直连 · 黑名单代理"
desc: |-
  参考 Mac mini 的 Clash Verge 分流逻辑。
  国内、局域网与未命中流量默认直连；GFW/Proxy 黑名单及指定服务走代理。
author: "Codex"
version: "2026.08.11"

mode: rule
ipv6: false

# Stash 移动端使用 2 个国内 DNS，兼顾耗电、国内 CDN 与抗污染。
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  follow-rule: false
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  nameserver-policy: #!replace
    "geosite:cn":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    "+.bigmodel.cn": https://dns.alidns.com/dns-query
    "+.feishu.cn": https://dns.alidns.com/dns-query
    "+.larksuite.com": https://dns.alidns.com/dns-query
    "+.feishuapp.cn": https://dns.alidns.com/dns-query
    "+.xiaohongshu.com": https://dns.alidns.com/dns-query
    "+.xhslink.com": https://dns.alidns.com/dns-query
    "+.xhslink.cn": https://dns.alidns.com/dns-query
    "+.xhscdn.com": https://dns.alidns.com/dns-query
    "+.xhscdn.net": https://dns.alidns.com/dns-query
  fake-ip-filter: #!replace
    - localhost
    - "+.lan"
    - "+.local"
    - "+.home.arpa"
    - "+.in-addr.arpa"
    - "+.ip6.arpa"
    - "time.*.com"
    - "time.*.gov"
    - pool.ntp.org
    - captive.apple.com
    - "+.icloud.com"
    - "+.icloud.com.cn"
    - "+.mzstatic.com"
    - "+.xiaohongshu.com"
    - "+.xhslink.com"
    - "+.xhslink.cn"
    - "+.xhscdn.com"
    - "+.xhscdn.net"
    - "+.bigmodel.cn"
    - "+.feishu.cn"
    - "+.larksuite.com"
    - "+.feishuapp.cn"
    - "+.interactivebrokers.com"
    - "+.ibkr.com"
    - "+.ibllc.com"

# include-all 会自动引用当前配置里的全部节点及 proxy-providers，
# 因而不需要把订阅地址或节点凭据写进本文件。
proxy-groups: #!replace
  - name: "代理模式"
    type: select
    proxies:
      - "🚀 自动优选"
      - "手动选择"
      - DIRECT

  - name: "🚀 自动优选"
    type: url-test
    include-all: true
    interval: 600
    lazy: true

  - name: "手动选择"
    type: select
    include-all: true

  - name: "美国节点"
    type: url-test
    include-all: true
    filter: "(?i)(美国|US|United States|America|🇺🇸|美)"
    interval: 600
    lazy: true

  - name: "日本节点"
    type: url-test
    include-all: true
    filter: "(?i)(日本|JP|Japan|🇯🇵)"
    interval: 600
    lazy: true

  - name: "澳洲节点"
    type: url-test
    include-all: true
    filter: "(?i)(澳大利亚|澳洲|AU|Australia|🇦🇺)"
    interval: 600
    lazy: true

  - name: "香港节点"
    type: url-test
    include-all: true
    filter: "(?i)(香港|HK|Hong Kong|HongKong|🇭🇰)"
    interval: 600
    lazy: true

  # 自动优选放在首位：即使订阅没有对应地区节点，也不会回落到 DIRECT。
  - name: "AI开发"
    type: select
    proxies:
      - "🚀 自动优选"
      - "美国节点"
      - "日本节点"
      - "澳洲节点"
      - "手动选择"

  - name: "ChatGPT"
    type: select
    proxies:
      - "🚀 自动优选"
      - "美国节点"
      - "澳洲节点"
      - "日本节点"
      - "手动选择"

  - name: "Claude"
    type: select
    proxies:
      - "🚀 自动优选"
      - "美国节点"
      - "澳洲节点"
      - "日本节点"
      - "手动选择"

  - name: "Google服务"
    type: select
    proxies:
      - "🚀 自动优选"
      - "美国节点"
      - "澳洲节点"
      - "手动选择"

  - name: "Spotify"
    type: select
    proxies:
      - "🚀 自动优选"
      - "香港节点"
      - "手动选择"

  - name: "影音流媒体"
    type: select
    proxies:
      - "🚀 自动优选"
      - "香港节点"
      - "美国节点"
      - "日本节点"
      - "手动选择"

  - name: "电报消息"
    type: select
    proxies:
      - "🚀 自动优选"
      - "手动选择"

  - name: "广告拦截"
    type: select
    proxies:
      - REJECT
      - DIRECT

  # 黑名单模式的关键：未命中规则默认 DIRECT，可在 Stash 中临时切换成代理。
  - name: "漏网之鱼"
    type: select
    proxies:
      - DIRECT
      - "代理模式"

rule-providers: #!replace
  reject:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt
    interval: 86400
  private:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/private.txt
    interval: 86400
  direct:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt
    interval: 86400
  lancidr:
    behavior: ipcidr
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/lancidr.txt
    interval: 86400
  gfw:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt
    interval: 86400
  proxy:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt
    interval: 86400
  github:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/github.txt
    interval: 86400
  google:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/google.txt
    interval: 86400
  telegramcidr:
    behavior: ipcidr
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/telegramcidr.txt
    interval: 86400
  openai:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/OpenAI/OpenAI.yaml
    interval: 86400
  claude:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Claude/Claude.yaml
    interval: 86400
  youtube:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/YouTube/YouTube.yaml
    interval: 86400
  netflix:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix.yaml
    interval: 86400
  spotify:
    behavior: classical
    format: yaml
    url: https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Spotify/Spotify.yaml
    interval: 86400

rules: #!replace
  # Tailnet / 局域网优先直连；保留 Mac mini 脚本里的 Headscale 控制面例外。
  - "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
  - "IP-CIDR6,fd7a:115c:a1e0::/48,DIRECT,no-resolve"
  - "DOMAIN,t.nyxbits.com,代理模式"

  # 广告与统计。
  - "DOMAIN-SUFFIX,google-analytics.com,Google服务"
  - "DOMAIN-SUFFIX,googletagservices.com,Google服务"
  - "RULE-SET,reject,广告拦截"

  # Claude。
  - "DOMAIN-SUFFIX,claude.ai,Claude"
  - "DOMAIN-SUFFIX,claude.com,Claude"
  - "DOMAIN-SUFFIX,anthropic.com,Claude"
  - "DOMAIN-SUFFIX,segment.io,Claude"
  - "DOMAIN-SUFFIX,website-files.com,Claude"
  - "DOMAIN-SUFFIX,intellimize.co,Claude"
  - "DOMAIN-SUFFIX,amplitude.com,Claude"
  - "RULE-SET,claude,Claude"

  # 流媒体。
  - "RULE-SET,spotify,Spotify"
  - "RULE-SET,youtube,影音流媒体"
  - "RULE-SET,netflix,影音流媒体"
  - "DOMAIN-SUFFIX,xbookcn.net,影音流媒体"

  # Google / Gemini。
  - "DOMAIN-SUFFIX,gemini.google.com,Google服务"
  - "DOMAIN-SUFFIX,generativeai.google.com,Google服务"
  - "DOMAIN-SUFFIX,ai.google.dev,Google服务"
  - "DOMAIN-SUFFIX,googleapis.com,Google服务"
  - "DOMAIN-SUFFIX,googleusercontent.com,Google服务"
  - "DOMAIN-SUFFIX,gstatic.com,Google服务"
  - "DOMAIN-SUFFIX,googletagmanager.com,Google服务"
  - "DOMAIN-SUFFIX,google.com,Google服务"
  - "RULE-SET,google,Google服务"

  # X / Grok / AI 开发。
  - "DOMAIN-SUFFIX,x.com,AI开发"
  - "DOMAIN-SUFFIX,x.ai,AI开发"
  - "DOMAIN-SUFFIX,grok.com,AI开发"
  - "DOMAIN-SUFFIX,playwright.dev,AI开发"
  - "DOMAIN-SUFFIX,githubcopilot.com,AI开发"
  - "DOMAIN-KEYWORD,antigravity,AI开发"
  - "DOMAIN-SUFFIX,clawhub.ai,AI开发"
  - "DOMAIN-SUFFIX,kiro.dev,AI开发"
  - "DOMAIN-SUFFIX,kiro.aws.dev,AI开发"
  - "DOMAIN-SUFFIX,nvidia.com,AI开发"
  - "DOMAIN-SUFFIX,slack.com,AI开发"
  - "DOMAIN-SUFFIX,githubusercontent.com,AI开发"
  - "DOMAIN-SUFFIX,github.com,AI开发"
  - "RULE-SET,github,AI开发"

  # OpenAI 与 Telegram。
  - "RULE-SET,openai,ChatGPT"
  - "RULE-SET,telegramcidr,电报消息,no-resolve"

  # Mac mini 脚本中的显式直连服务。
  - "DOMAIN-SUFFIX,bigmodel.cn,DIRECT"
  - "DOMAIN-SUFFIX,feishu.cn,DIRECT"
  - "DOMAIN-SUFFIX,larksuite.com,DIRECT"
  - "DOMAIN-SUFFIX,feishuapp.cn,DIRECT"
  - "DOMAIN-SUFFIX,interactivebrokers.com,DIRECT"
  - "DOMAIN-SUFFIX,ibllc.com,DIRECT"
  - "DOMAIN-SUFFIX,ibkr.com,DIRECT"
  - "DOMAIN-SUFFIX,ibkr.com.au,DIRECT"
  - "DOMAIN-SUFFIX,ibkr.com.hk,DIRECT"
  - "DOMAIN-SUFFIX,ibkr.pro,DIRECT"
  - "DOMAIN-SUFFIX,office365.com,DIRECT"
  - "DOMAIN-SUFFIX,office.com,DIRECT"
  - "DOMAIN-SUFFIX,office.net,DIRECT"
  - "DOMAIN-SUFFIX,microsoftonline.com,DIRECT"
  - "DOMAIN-KEYWORD,onedrive,DIRECT"
  - "DOMAIN-KEYWORD,sharepoint,DIRECT"
  - "DOMAIN-SUFFIX,deepseek.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,mzstatic.com,DIRECT"
  - "DOMAIN-SUFFIX,itunes.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,me.com,DIRECT"
  - "DOMAIN-SUFFIX,update.microsoft.com,DIRECT"
  - "DOMAIN-SUFFIX,windowsupdate.com,DIRECT"
  - "DOMAIN-SUFFIX,delivery.mp.microsoft.com,DIRECT"
  - "DOMAIN-SUFFIX,dl.delivery.mp.microsoft.com,DIRECT"
  - "DOMAIN-SUFFIX,steamserver.net,DIRECT"
  - "DOMAIN-SUFFIX,steamcontent.com,DIRECT"
  - "DOMAIN-KEYWORD,steamcontent,DIRECT"
  - "DOMAIN-SUFFIX,epicgames.com,DIRECT"
  - "DOMAIN-SUFFIX,zoom.us,DIRECT"
  - "DOMAIN-SUFFIX,zoom.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,webex.com,DIRECT"
  - "DOMAIN-SUFFIX,xiaohongshu.com,DIRECT"
  - "DOMAIN-SUFFIX,xhslink.com,DIRECT"
  - "DOMAIN-SUFFIX,xhslink.cn,DIRECT"
  - "DOMAIN-SUFFIX,xhscdn.com,DIRECT"
  - "DOMAIN-SUFFIX,xhscdn.net,DIRECT"
  - "IP-CIDR,63.86.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,198.90.0.0/16,DIRECT,no-resolve"

  # 私网、国内域名与国内 IP 优先直连。
  - "RULE-SET,private,DIRECT"
  - "RULE-SET,lancidr,DIRECT,no-resolve"
  - "RULE-SET,direct,DIRECT"
  - "GEOSITE,CN,DIRECT"

  # 黑名单命中才走代理。
  - "RULE-SET,gfw,代理模式"
  - "RULE-SET,proxy,代理模式"
  - "GEOIP,CN,DIRECT,no-resolve"

  # 未命中默认直连，符合黑名单模式。
  - "MATCH,漏网之鱼"
